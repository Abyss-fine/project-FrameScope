{
  "name": "framescope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FrameScope Backend v0.1 — Express и SQLite",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "import": "node --env-file-if-exists=.env scripts/import.js",
    "import:offline": "node --env-file-if-exists=.env scripts/import.js --offline",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^6.2.1",
    "express": "^5.3.0"
  }
}
